# Copy to .env (gitignored) and adjust. Local-dev values only; never put real secrets here.

# Image coordinates produced by scripts/build-images.sh (mvn spring-boot:build-image)
IMAGE_REGISTRY=ecom
IMAGE_TAG=0.1.0-SNAPSHOT

# Postgres superuser (service users/passwords are fixed in config/postgres-init.sql)
POSTGRES_PASSWORD=postgres

# Bootstrap admin created by user-service at startup (used by scripts/smoke-test.sh)
ADMIN_EMAIL=admin@ecom.local
ADMIN_PASSWORD=change-me-admin-Passw0rd

# JWT: Compose uses an ephemeral RSA key generated at user-service startup.
# To use a stable key instead: set JWT_EPHEMERAL_KEY=false and JWT_PRIVATE_KEY_PEM from scripts/dev-keys.sh
# (PKCS#8 PEM on ONE line with literal \n separators; user-service converts them back)
JWT_EPHEMERAL_KEY=true
JWT_PRIVATE_KEY_PEM=
JWT_KEY_ID=local-dev

# Fake PSP (deterministic by payment-method token); webhook secret for the dev signing loop
PSP_MODE=fake
PSP_WEBHOOK_SECRET=whsec_local_dev_secret

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Tracing (set TRACING_ENABLED=false when the observability profile is not running)
TRACING_ENABLED=true
TRACING_SAMPLING_PROBABILITY=1.0

# Host ports
GATEWAY_PORT=8080
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
